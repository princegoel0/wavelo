{
  "name": "@wavelo/angular",
  "version": "0.4.0",
  "description": "An Angular standalone component for CSS loading spinners, skeletons and progress, library-compiled so AOT builds accept it",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princegoel0/wavelo.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/princegoel0/wavelo/issues"
  },
  "homepage": "https://github.com/princegoel0/wavelo#readme",
  "keywords": [
    "loading",
    "spinner",
    "loader",
    "angular",
    "animation",
    "accessible",
    "css",
    "reduced-motion",
    "angular-spinner",
    "loading-indicator",
    "skeleton",
    "progress",
    "standalone-component",
    "aot",
    "typescript"
  ],
  "dependencies": {
    "@wavelo/core": "0.4.0"
  },
  "peerDependencies": {
    "@angular/core": ">=14.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "ngc -p tsconfig.json"
  },
  "author": "Prince Goel",
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
