{
  "name": "@wavelo/svelte",
  "version": "0.4.0",
  "description": "Svelte 5 components for CSS loading spinners, skeletons and progress, built with runes and a context for shared defaults",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princegoel0/wavelo.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/princegoel0/wavelo/issues"
  },
  "homepage": "https://github.com/princegoel0/wavelo#readme",
  "keywords": [
    "loading",
    "spinner",
    "loader",
    "svelte",
    "animation",
    "accessible",
    "css",
    "reduced-motion",
    "svelte-spinner",
    "loading-indicator",
    "skeleton",
    "progress",
    "sveltekit",
    "runes",
    "typescript"
  ],
  "dependencies": {
    "@wavelo/core": "0.4.0"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0 <6.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/WaveloLoader.svelte"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./WaveloLoader.svelte": "./src/WaveloLoader.svelte",
    "./Wavelo.svelte": "./src/WaveloLoader.svelte"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "author": "Prince Goel",
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
