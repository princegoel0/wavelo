{
  "name": "@wavelo/react",
  "version": "0.5.0",
  "description": "React components for CSS loading spinners, skeletons and progress, with a React Server Component boundary built in",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princegoel0/wavelo.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/princegoel0/wavelo/issues"
  },
  "homepage": "https://github.com/princegoel0/wavelo#readme",
  "keywords": [
    "loading",
    "spinner",
    "loader",
    "react",
    "animation",
    "accessible",
    "css",
    "reduced-motion",
    "react-spinner",
    "loading-indicator",
    "skeleton",
    "progress",
    "nextjs",
    "server-components",
    "typescript"
  ],
  "dependencies": {
    "@wavelo/core": "0.5.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "author": "Prince Goel",
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
