{
  "name": "@wavelo/core",
  "version": "0.4.0",
  "description": "CSS loading spinners, skeletons and progress indicators that render as markup plus one shared stylesheet, with no runtime dependencies",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princegoel0/wavelo.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/princegoel0/wavelo/issues"
  },
  "homepage": "https://github.com/princegoel0/wavelo#readme",
  "keywords": [
    "loading",
    "spinner",
    "loader",
    "skeleton",
    "progress",
    "animation",
    "css",
    "accessible",
    "reduced-motion",
    "ui",
    "loading-indicator",
    "preloader",
    "skeleton-loader",
    "typescript",
    "zero-dependency"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js"
    },
    "./css": {
      "types": "./dist/css/index.d.ts",
      "import": "./dist/css/index.js"
    },
    "./css/base": {
      "types": "./dist/css/base.d.ts",
      "import": "./dist/css/base.js"
    },
    "./css/kinds/*": {
      "types": "./dist/css/kinds/*.d.ts",
      "import": "./dist/css/kinds/*.js"
    },
    "./loaders": {
      "types": "./dist/loaders/index.d.ts",
      "import": "./dist/loaders/index.js"
    },
    "./loaders/*": {
      "types": "./dist/loaders/*.d.ts",
      "import": "./dist/loaders/*.js"
    },
    "./styles.css": "./dist/wavelo.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.json && node ../../scripts/emit-stylesheet.mjs && node ../../scripts/emit-tokens.mjs && node ../../scripts/emit-cjs.mjs"
  },
  "author": "Prince Goel",
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
