{
  "name": "wavelo",
  "version": "0.5.0",
  "private": true,
  "description": "Universal loading and motion library",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/docs"
  ],
  "scripts": {
    "build": "npm run build:core && node scripts/generate-catalog.mjs && npm run build:all",
    "build:core": "npm run build --workspace @wavelo/core",
    "build:all": "npm run build --workspaces --if-present",
    "check": "npm run build && npm run typecheck && npm test && npm run verify:angular && npm run verify:react && npm run verify:examples && npm run catalog && npm run packages:check && npm run docs:check && npm run measure",
    "packages:check": "node scripts/validate-packages.mjs",
    "verify:angular": "node scripts/verify-angular-package.mjs",
    "verify:react": "node scripts/verify-react-entries.mjs",
    "verify:examples": "node scripts/verify-examples.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 tests/core.test.mjs tests/framework.test.mjs tests/angular.test.mjs tests/angular-ssr.test.mjs",
    "catalog": "node scripts/validate-catalog.mjs",
    "catalog:generate": "npm run build:core && node scripts/honoured-options.mjs && npm run build:core && node scripts/generate-catalog.mjs && npm run build:core",
    "audit:customization": "node scripts/honoured-options.mjs --check",
    "docs:check": "node scripts/validate-docs.mjs",
    "measure": "node scripts/bundle.mjs",
    "audit:layout": "node scripts/layout-cost.mjs",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:visual:correctness": "node scripts/audit-loader-visual-correctness.mjs",
    "release:validate": "node scripts/validate-release.mjs",
    "docs:build": "npm run build --workspace @wavelo/docs",
    "docs:verify": "node scripts/verify-gallery.mjs",
    "pack:check": "npm pack --dry-run --workspaces --if-present",
    "pack:verify": "node scripts/verify-packed.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test:browser:firefox": "node tests/browser-firefox.test.mjs",
    "test:browser:webkit": "node tests/browser-webkit.test.mjs",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:visual:update": "node scripts/visual-regression.mjs --update-baselines"
  },
  "devDependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "domino": "^2.1.8",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.3",
    "typescript": "^6.0.3",
    "vue": "^3.5.44",
    "zone.js": "^0.16.3"
  }
}
