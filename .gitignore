node_modules/
dist/
coverage/
*.tsbuildinfo
*.tgz
release-tarballs/
release-consumer/
# Review artifacts: contact sheets, filmstrips and per-design screenshots written by
# audit:visual, audit:visual:correctness, scripts/filmstrip.mjs and
# scripts/capture-constellations.mjs. Every one is reproducible from the current build,
# and a committed screenshot goes stale the moment a design is redrawn — which is how
# 4.6 MB of PNGs describing a catalog that no longer ships ended up in the repository.
release-audit/

# Review previews and findings written by design-review runs. Same rule as
# release-audit/: reproducible artifacts describing a catalog that keeps moving.
outputs/

# scripts/deep-design-audit.mjs writes its per-design results here. A generated report at
# the repository root shows up in `git status` and gets swept into the next commit.
audit-results.json

# tests/framework.test.mjs compiles the shipped Svelte component to a server module here, so
# the file is a build product of the test run rather than a fixture someone can edit.
tests/fixtures/generated/

.agency/
